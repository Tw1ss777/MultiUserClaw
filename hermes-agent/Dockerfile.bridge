ARG BASE_TAG=latest
FROM hermes-base:${BASE_TAG}

ENV PYTHONUNBUFFERED=1
ENV PLAYWRIGHT_BROWSERS_PATH=/opt/hermes/.playwright
ENV PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=0
ENV AGENT_BROWSER_EXECUTABLE_PATH=/usr/bin/chromium

ARG APT_DEBIAN_MIRROR=""
ARG APT_SECURITY_MIRROR=""
ARG PIP_INDEX_URL=https://pypi.org/simple
ARG NPM_REGISTRY=https://registry.npmmirror.com
ARG PLAYWRIGHT_DOWNLOAD_HOST=https://npmmirror.com/mirrors/playwright
ARG HERMES_INSTALL_BROWSER=false
ARG HERMES_INSTALL_WHATSAPP_BRIDGE=false
ENV PLAYWRIGHT_DOWNLOAD_HOST=${PLAYWRIGHT_DOWNLOAD_HOST}

# Install document-processing system dependencies only.
# chromium / playwright browsers / pango-cairo libs / python3-pip are already
# in hermes-base — reinstalling them here doubled the image size.
# The apt mirror is controlled by APT_DEBIAN_MIRROR / APT_SECURITY_MIRROR args
# (defaults to empty for stock Debian mirrors; set to USTC mirrors for CN builds).
RUN --mount=type=cache,target=/root/.cache/pip \
    if [ -n "${APT_DEBIAN_MIRROR}" ]; then \
        sed -i "s|http://deb.debian.org/debian|${APT_DEBIAN_MIRROR}|g" /etc/apt/sources.list.d/debian.sources; \
    fi && \
    if [ -n "${APT_SECURITY_MIRROR}" ]; then \
        sed -i "s|http://security.debian.org|${APT_SECURITY_MIRROR}|g" /etc/apt/sources.list.d/debian.sources; \
    fi && \
    apt-get -o Acquire::Retries=5 update && \
    apt-get -o Acquire::Retries=5 install -y --no-install-recommends \
        poppler-utils tesseract-ocr tesseract-ocr-chi-sim tesseract-ocr-eng \
        libreoffice-core libreoffice-writer libreoffice-calc \
        libmagic1 file antiword catdoc && \
    rm -rf /var/lib/apt/lists/* && \
    pip3 install --break-system-packages -i ${PIP_INDEX_URL} \
        requests pymupdf pdfplumber python-docx openpyxl python-pptx pandas xlrd odfpy python-magic chardet

# Playwright python package only — browsers already installed in hermes-base
RUN --mount=type=cache,target=/root/.cache/pip \
    pip3 install --break-system-packages -i ${PIP_INDEX_URL} playwright
WORKDIR /opt/hermes
# npm settings via ENV so they apply to every user (installs below run as hermes)
ENV npm_config_fetch_retries=5
ENV npm_config_fetch_retry_mintimeout=20000
ENV npm_config_fetch_retry_maxtimeout=120000
ENV npm_config_registry=${NPM_REGISTRY}

# All installs below run as hermes: files land hermes-owned from the start, so
# no recursive chown/chmod layers are needed (those duplicated ~5GB per build).
# Two surgical ownership fixes instead:
#   1. base ships a pre-built .venv whose editable-install artifacts are
#      root-owned (~18 files) — the editable re-install and lazy_deps must own them.
#   2. every root-owned DIRECTORY under /opt/hermes (e.g. web/public/fonts) goes
#      to hermes: unlinking files needs write permission on the containing dir,
#      not the files themselves. Dir inodes are tiny — no content duplication
#      (chowning the file trees, like the old blanket chmod/chown -R did, cost 5.7GB).
#   3. drop the stale root-owned tsc cache dir — tsc overwrites *.tsbuildinfo
#      in place (not delete+create), so a root-owned file there is unwritable.
RUN chown -R hermes:hermes /opt/hermes/.venv && \
    find /opt/hermes -xdev -type d -user root -exec chown hermes:hermes {} + && \
    rm -rf /opt/hermes/web/node_modules/.tmp
USER hermes

# WhatsApp bridge (optional)
COPY --chown=hermes:hermes scripts/whatsapp-bridge/package.json scripts/whatsapp-bridge/package-lock.json ./scripts/whatsapp-bridge/
RUN --mount=type=cache,target=/home/hermes/.npm,uid=10000,gid=10000 \
    if [ "$HERMES_INSTALL_WHATSAPP_BRIDGE" = "true" ]; then \
        cd /opt/hermes/scripts/whatsapp-bridge && npm install --prefer-offline --no-audit --no-fund; \
    else \
        echo "Skipping WhatsApp bridge npm install; rebuild with HERMES_INSTALL_WHATSAPP_BRIDGE=true to include WhatsApp bridge dependencies."; \
    fi

# ---- dependency layers FIRST (cached until manifests change) -----------------
# Copy manifests only, so the npm/uv install layers stay cached on code-only builds.
COPY --chown=hermes:hermes pyproject.toml requirements.txt package.json package-lock.json* ./

# Root npm dependencies (agent-browser CLI, Playwright CLI); browsers are in base.
# npm cache lives in a buildkit cache mount, not in the image.
RUN --mount=type=cache,target=/home/hermes/.npm,uid=10000,gid=10000 \
    npm install --prefer-offline --no-audit

# venv + document-processing libs — stable layer, only re-runs when manifests change
RUN --mount=type=cache,target=/home/hermes/.cache/uv,uid=10000,gid=10000 \
    if [ ! -d /opt/hermes/.venv ]; then uv venv --seed /opt/hermes/.venv; fi && \
    uv pip install -i ${PIP_INDEX_URL} setuptools wheel weasyprint \
        pymupdf pdfplumber python-docx openpyxl python-pptx pandas xlrd odfpy python-magic chardet

# ---- source layers LAST (only these re-run on code changes) ------------------
COPY --chown=hermes:hermes acp_adapter agent cron gateway hermes_cli plugins tools ./
COPY --chown=hermes:hermes batch_runner.py cli.py hermes_constants.py hermes_logging.py hermes_state.py hermes_time.py model_tools.py rl_cli.py run_agent.py setup.py toolset_distributions.py toolsets.py trajectory_compressor.py utils.py ./

# Editable install re-runs on every code change, but the warm uv cache mount
# makes it metadata-only — no package downloads, seconds instead of minutes.
RUN --mount=type=cache,target=/home/hermes/.cache/uv,uid=10000,gid=10000 \
    uv pip install --no-build-isolation -i ${PIP_INDEX_URL} --extra-index-url https://pypi.org/simple/ -e ".[all]"

COPY --chown=hermes:hermes . /opt/hermes

# Build frontend assets (web dashboard + terminal UI)
RUN cd web && npm run build && \
    cd ../ui-tui && npm run build

USER root
RUN chmod +x /opt/hermes/docker/entrypoint.sh

# ---- skill Python 依赖：python3-pypff (libpff) -------------------------------
# parse-pst skill 需要 pypff 模块。不要用 pip：PyPI 上的 libpff-python 没有
# Linux wheel（只有 macOS + sdist），且容器里的 pip 受 PEP 668 限制、venv 内
# 根本没有 pip。Debian 13 源里已有 python3-pypff，用它。
# 注意它装在 /usr/lib/python3/dist-packages，而运行时是 /opt/hermes/.venv 里的
# python，venv 不包含 dist-packages，所以把 .so 软链进 venv 的 site-packages。
# 用 python 自身解析 site-packages 路径，避免硬编码 Python 版本号。
# 这一层刻意放在文件末尾：只新增一个几 MB 的小层，不会让上面的
# npm install / uv install / COPY . / web build 缓存失效。
RUN apt-get -o Acquire::Retries=5 update && \
    apt-get -o Acquire::Retries=5 install -y --no-install-recommends python3-pypff && \
    VENV_SP="$(/opt/hermes/.venv/bin/python3 -c 'import site; print(site.getsitepackages()[0])')" && \
    ln -sf /usr/lib/python3/dist-packages/pypff*.so "$VENV_SP/" && \
    rm -rf /var/lib/apt/lists/*

ENV HERMES_WEB_DIST=/opt/hermes/hermes_cli/web_dist
ENV HERMES_HOME=/opt/data
ENV PATH="/opt/data/.local/bin:${PATH}"
VOLUME [ "/opt/data" ]
ENTRYPOINT [ "/opt/hermes/docker/entrypoint.sh" ]

ENV API_SERVER_ENABLED=true
ENV API_SERVER_HOST=0.0.0.0
ENV API_SERVER_PORT=18080
ENV API_SERVER_KEY=dev-hermes-bridge-key
ENV GATEWAY_ALLOW_ALL_USERS=true

EXPOSE 18080

CMD ["gateway", "run", "-v"]
